{
  "info": {
    "name": "API Alumnos - Taller 2 (dev)",
    "description": "URL del despliegue dev ya configurada. Ejecuta la colección en orden: Crear, Listar, Buscar, Modificar y Eliminar. Crear genera un alumno_id de prueba único. No requiere token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": { "type": "noauth" },
  "variable": [
    { "key": "baseUrl", "value": "https://zv2cnq3ai5.execute-api.us-east-1.amazonaws.com/dev" },
    { "key": "tenant_id", "value": "UTEC" },
    { "key": "alumno_id", "value": "TEST-PENDIENTE" }
  ],
  "item": [
    {
      "name": "1. CrearAlumno",
      "event": [
        {
          "listen": "prerequest",
          "script": { "type": "text/javascript", "exec": ["pm.collectionVariables.set('alumno_id', 'TEST-' + Date.now());"] }
        },
        {
          "listen": "test",
          "script": { "type": "text/javascript", "exec": [
            "pm.test('Crear devuelve HTTP 201', () => pm.response.to.have.status(201));",
            "const data = pm.response.json();",
            "pm.test('Alumno creado con el ID de prueba', () => {",
            "  pm.expect(data.alumno.tenant_id).to.eql(pm.collectionVariables.get('tenant_id'));",
            "  pm.expect(data.alumno.alumno_id).to.eql(pm.collectionVariables.get('alumno_id'));",
            "});"
          ] }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tenant_id\": \"{{tenant_id}}\",\n  \"alumno_id\": \"{{alumno_id}}\",\n  \"alumno_datos\": {\n    \"nombre\": \"Juana del Arco\",\n    \"sexo\": \"F\",\n    \"fecha_nac\": \"2000-09-01\",\n    \"celular\": \"999736332\",\n    \"domicilio\": {\n      \"direcc\": \"Av. Javier Prado 158\",\n      \"distrito\": \"San Isidro\",\n      \"provincia\": \"Lima\",\n      \"departamento\": \"Lima\",\n      \"pais\": \"Perú\"\n    }\n  }\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/alumnos/crear"
      }
    },
    {
      "name": "2. ListarAlumnos",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Listar devuelve HTTP 200', () => pm.response.to.have.status(200));",
        "const data = pm.response.json();",
        "pm.test('Lista y cantidad válidas', () => {",
        "  pm.expect(data.tenant_id).to.eql(pm.collectionVariables.get('tenant_id'));",
        "  pm.expect(data.alumnos).to.be.an('array');",
        "  pm.expect(data.num_reg).to.eql(data.alumnos.length);",
        "});"
      ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"tenant_id\": \"{{tenant_id}}\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/alumnos/listar"
      }
    },
    {
      "name": "3. BuscarAlumno",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Buscar devuelve HTTP 200', () => pm.response.to.have.status(200));",
        "const data = pm.response.json();",
        "pm.test('Se encontró el alumno creado', () => {",
        "  pm.expect(data.alumno.alumno_id).to.eql(pm.collectionVariables.get('alumno_id'));",
        "});"
      ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"tenant_id\": \"{{tenant_id}}\",\n  \"alumno_id\": \"{{alumno_id}}\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/alumnos/buscar"
      }
    },
    {
      "name": "4. ModificarAlumno",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Modificar devuelve HTTP 200', () => pm.response.to.have.status(200));",
        "const data = pm.response.json();",
        "pm.test('El celular quedó actualizado', () => {",
        "  pm.expect(data.alumno.alumno_id).to.eql(pm.collectionVariables.get('alumno_id'));",
        "  pm.expect(data.alumno.alumno_datos.celular).to.eql('999000111');",
        "});"
      ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tenant_id\": \"{{tenant_id}}\",\n  \"alumno_id\": \"{{alumno_id}}\",\n  \"alumno_datos\": {\n    \"nombre\": \"Juana del Arco\",\n    \"sexo\": \"F\",\n    \"fecha_nac\": \"2000-09-01\",\n    \"celular\": \"999000111\",\n    \"domicilio\": {\n      \"direcc\": \"Av. Javier Prado 158\",\n      \"distrito\": \"San Isidro\",\n      \"provincia\": \"Lima\",\n      \"departamento\": \"Lima\",\n      \"pais\": \"Perú\"\n    }\n  }\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/alumnos/modificar"
      }
    },
    {
      "name": "5. EliminarAlumno",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Eliminar devuelve HTTP 200', () => pm.response.to.have.status(200));",
        "const data = pm.response.json();",
        "pm.test('Se eliminó el alumno de prueba', () => {",
        "  pm.expect(data.alumno_id).to.eql(pm.collectionVariables.get('alumno_id'));",
        "  pm.expect(data.mensaje).to.eql('Alumno eliminado');",
        "});"
      ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"tenant_id\": \"{{tenant_id}}\",\n  \"alumno_id\": \"{{alumno_id}}\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/alumnos/eliminar"
      }
    }
  ]
}
